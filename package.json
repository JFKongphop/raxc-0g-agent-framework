{
  "name": "raxclaw",
  "version": "1.0.0",
  "type": "module",
  "description": "RAXC × OpenClaw — autonomous smart contract security auditor on 0G",
  "packageManager": "pnpm@latest",
  "bin": {
    "raxclaw": "./dist/raxclaw"
  },
  "scripts": {
    "build": "node build.cjs",
    "build:rust": "cargo build --release --example agent_example_remote --manifest-path backend/Cargo.toml",
    "build:all": "node build.cjs && cargo build --release --example agent_example_remote --manifest-path backend/Cargo.toml",
    "dev": "tsx raxclaw.tsx",
    "analyze": "tsx raxclaw.tsx analyze",
    "setup": "openclaw setup"
  },
  "devDependencies": {
    "@types/node": "^25.7.0",
    "@types/react": "^19.2.14",
    "esbuild": "^0.28.0",
    "openclaw": "latest",
    "tsx": "^4.0.0"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "ink": "^7.0.3",
    "ink-spinner": "^5.0.0",
    "react": "^19.2.6"
  }
}
